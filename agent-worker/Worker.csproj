<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseAppHost>false</UseAppHost>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.AgentServer.Core" Version="[1.0.0-beta.29]" />
    <PackageReference Include="Azure.AI.AgentServer.Invocations" Version="[1.0.0-beta.7]" />
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.26.0]" />
    <PackageReference Include="Azure.Identity" Version="[1.21.0]" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="[7.21.0]" />
    <PackageReference Include="Azure.Messaging.WebPubSub" Version="[1.7.0]" />
    <InternalsVisibleTo Include="WorkerClient" />
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
</Project>
