{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\Connector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "SDV.AgentExtension.Connector"
    }
  },
  "Connector": {
    // Optional deployment label for operator status. The installer sets Connector__Environment.
    "Environment": "",
    // Branch ID from the deployment catalog, as a string of digits.
    "BranchId": "",
    // Windows service name registered by Manage-Connector.ps1 via Connector__ServiceName.
    "ServiceName": "",
    "Api": {
      // Loopback URL and port of the branch's local 1C HTTP API, e.g. http://127.0.0.1:18101.
      "BaseUri": "",
      // Basic credentials of the 1C user. Put User and Password only into appsettings.Development.json.
      "User": "",
      "Password": "",
      // Absolute path of the health check. GET with IBSession start/finish also opens and closes the 1C session.
      "PingPath": "",
      // Absolute path of the order lookup (POST).
      "LookupPath": ""
    },
    "ServiceBus": {
      // Copy commandListenConnectionString from the local Service Bus bundle for this branch.
      "CommandListenConnectionString": "",
      // Copy resultSendConnectionString from the same bundle. It must have Send on results only.
      "ResultSendConnectionString": ""
    },
    "Telegram": {
      // Enable when the branch has a configured bot. Set false when Telegram is unused.
      "Enabled": true,
      // Copy botToken from the local Telegram setup file or use the token issued by BotFather.
      "BotToken": "",
      // Use chatId confirmed by Set-TelegramCredential.ps1 in the bot's private chat.
      "ChatId": 0,
      // Use the allowedUserIds confirmed by the same private-chat setup.
      "AllowedUserIds": []
    }
  }
}
